{
  "name": "alpa-seasonal-vip-stories",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lab": "vite --host 0.0.0.0 --open /lab.html",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "video:dev": "bash scripts/encode-video.sh dev",
    "video:prod": "bash scripts/encode-video.sh prod",
    "frames": "bash scripts/extract-frames.sh",
    "pose:check": "node scripts/probe.mjs --all",
    "fit:check": "node scripts/probe.mjs --fit",
    "fly:check": "node scripts/probe.mjs --fly",
    "audit": "node scripts/audit-slides.mjs",
    "strip": "node scripts/filmstrip.mjs",
    "clip:fit": "node scripts/clip-fit.mjs",
    "clip:selftest": "node scripts/clip-fit.mjs --selftest",
    "tiles:fit": "node scripts/tile-fit.mjs",
    "tiles:selftest": "node scripts/tile-fit.mjs --selftest",
    "journal:motion": "node scripts/journal-measure.mjs --motion",
    "journal:pose": "node scripts/journal-measure.mjs",
    "journal:selftest": "node scripts/journal-measure.mjs --selftest",
    "journal:path": "node scripts/journal-path.mjs",
    "fly:measure": "node scripts/fly-measure.mjs",
    "smooth:scan": "node scripts/smooth-scan.mjs",
    "smooth:report": "node scripts/smooth-report.mjs",
    "fly:sprites": "node scripts/fly-sprites.mjs",
    "check-locales": "node scripts/check-locales.mjs",
    "fmt": "prettier -w .",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "vite": "^6.0.7"
  }
}
